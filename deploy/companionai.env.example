# CompanionAI production environment.
#
#   sudo install -o root -g root -m 0600 companionai.env.example /etc/companionai/companionai.env
#   sudoedit /etc/companionai/companionai.env
#
# systemd parses EnvironmentFile as root before dropping to User=companionai, so
# root:root 0600 is correct here and the service user never reads this file.
#
# Every key here is also readable from a root-only `systemctl show companionai --property=Environment`.
# That is inherent to putting secrets in an environment file, and is still a real
# improvement on -D arguments, which are readable by every local user via `ps -ef`.

# --- Server bind -----------------------------------------------------------------
# 127.0.0.1, not 0.0.0.0. Nginx is the only public entry point; binding wide would
# expose CompanionAI directly and bypass the TLS terminator and the auth filter.
COMPANIONAI_HOST=127.0.0.1
COMPANIONAI_PORT=8080

# --- Authentication --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# Leave unset to disable the filter entirely -- which means the chat is open to
# anyone who can reach the port. Not acceptable once Nginx is public.
COMPANIONAI_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32

# --- Persistent data -------------------------------------------------------------
# Must live outside any deployment directory so a redeploy cannot clobber it.
COMPANIONAI_DATA_DIR=/var/lib/companionai/data

# SSRF control. Keep false: the app fetches URLs from model and retrieval output,
# and true would let a prompt aim requests at loopback and the LAN.
COMPANIONAI_ALLOW_PRIVATE_FETCH=false

# --- Inference -------------------------------------------------------------------
LLM_PROVIDER=fastflowlm
LLM_MODEL=qwen2.5-it:3b
LLM_BASE_URL=http://127.0.0.1:52625
LLM_TEMPERATURE=0.7
LLM_THINK=false

# LLM_NUM_CTX is intentionally absent. FastFlowLM ignores a per-request context
# length and the factory logs a warning if it is set. Context size is a property of
# the model artefact and gets chosen in the bake-off, not configured here.