# CompanionAI production environment.
#
#   sudo install -o root -g root -m 0600 companionai.env.example /etc/companionai/companionai.env
#   sudoedit /etc/companionai/companionai.env
#
# systemd parses EnvironmentFile as root before dropping to User=companionai, so
# root:root 0600 is correct here and the service user never reads this file.
#
# Every key here is also readable from a root-only `systemctl show companionai --property=Environment`.
# That is inherent to putting secrets in an environment file, and is still a real
# improvement on -D arguments, which are readable by every local user via `ps -ef`.

# --- Server bind -----------------------------------------------------------------
# 127.0.0.1, not 0.0.0.0. Nginx is the only public entry point; binding wide would
# expose CompanionAI directly and bypass the TLS terminator and the auth filter.
COMPANIONAI_HOST=127.0.0.1
COMPANIONAI_PORT=8080

# --- Authentication --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
# Leave unset to disable the filter entirely -- which means the chat is open to
# anyone who can reach the port. Not acceptable once Nginx is public.
COMPANIONAI_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32

# --- Persistent data -------------------------------------------------------------
# Must live outside any deployment directory so a redeploy cannot clobber it.
COMPANIONAI_DATA_DIR=/var/lib/companionai/data

# SSRF control. Keep false: the app fetches URLs from model and retrieval output,
# and true would let a prompt aim requests at loopback and the LAN.
COMPANIONAI_ALLOW_PRIVATE_FETCH=false

# --- Inference -------------------------------------------------------------------
LLM_PROVIDER=fastflowlm
LLM_MODEL=qwen2.5-it:3b
LLM_BASE_URL=http://127.0.0.1:52625
LLM_TEMPERATURE=0.7
LLM_THINK=false

# LLM_NUM_CTX is intentionally absent. FastFlowLM ignores a per-request context
# length and the factory logs a warning if it is set. Context size is a property of
# the model artefact and gets chosen in the bake-off, not configured here.

# --- Live information retrieval ---------------------------------------------------
# These are the settings that used to work only as -D properties. They now accept the
# environment too, which matters here: a key passed as -D is world-readable in `ps -ef`.
#
# An unset key means that provider is off. Sports and web search are disabled silently,
# not loudly — the app still starts and the model simply answers from its own knowledge.
# COMPANIONAI_SPORTS_API_KEY is API-Football (https://dashboard.api-football.com/).
# COMPANIONAI_SEARCH_API_KEY is Tavily (https://tavily.com/); web search also fetches
# page bodies, so it needs outbound HTTPS.

COMPANIONAI_SPORTS_API_KEY=
COMPANIONAI_SEARCH_API_KEY=

# Weather (Open-Meteo) needs no key, only a location to fall back on when the
# question does not name one.
#
# Quote any value containing a space. systemd strips the surrounding quotes before
# the variable reaches the process, so the app sees a clean "Uxbridge, UK".
COMPANIONAI_LIVE_DEFAULT_LOCATION="Uxbridge, UK"

COMPANIONAI_LIVE_ENABLED=true

# --- Lookup vs Research budgets ----------------------------------------------------
# A pointed question runs in Lookup mode: one cheap Tavily `basic` search, recent
# news only. Wording that asks for a sweep ("all the stories", "every article")
# runs in Research mode instead, which is the block below. The mode is chosen from
# the question, so neither block can be turned on without the other; these values
# set the budget each one spends.
COMPANIONAI_LIVE_WEB_RESULTS=5
COMPANIONAI_LIVE_FETCH_PAGES=2
COMPANIONAI_LIVE_SEARCH_DEPTH=basic
COMPANIONAI_LIVE_WEB_TOPIC=news
COMPANIONAI_LIVE_WEB_TIME_RANGE=week

# Research mode. Hard-capped at 3 queries whatever this says, because the queries
# are generated deterministically from the request rather than by the model.
COMPANIONAI_LIVE_WEB_RESEARCH_RESULTS=20
COMPANIONAI_LIVE_WEB_RESEARCH_FETCH_PAGES=6
COMPANIONAI_LIVE_WEB_RESEARCH_QUERIES=3
COMPANIONAI_LIVE_WEB_RESEARCH_SEARCH_DEPTH=advanced
COMPANIONAI_LIVE_WEB_RESEARCH_TOPIC=general
# Empty means no time window is sent at all, which is the correct default for
# "give me all the stories" — a sweep should not silently inherit a recency filter.
COMPANIONAI_LIVE_WEB_RESEARCH_TIME_RANGE=

# Only change this to route Tavily through a local proxy or a test double.
# COMPANIONAI_LIVE_WEB_SEARCH_URL=https://api.tavily.com/search

# --- Cloud fallback (optional) -------------------------------------------------------
# Disabled by default. When enabled, the app may fall back to a local-first cloud
# OpenAI-compatible endpoint after a local LLM failure, but never for Research
# requests. By default no KB documents and no chat history are sent (opt-in).
# COMPANIONAI_CLOUD_ENABLED=false
# COMPANIONAI_CLOUD_BASE_URL=
# COMPANIONAI_CLOUD_API_KEY=
# COMPANIONAI_CLOUD_MODEL=
# COMPANIONAI_CLOUD_TEMPERATURE=0.2
# COMPANIONAI_CLOUD_INCLUDE_HISTORY=false
